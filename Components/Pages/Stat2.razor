@page "/stat2"
@using ART122.Data
@using ART122.Services
@inject IDeclarationService DeclarationService
@inject IRedevableService RedevableService
@inject IAppSettingsService AppSettingsService
@inject IJSRuntime JS

@* ── Toolbar ───────────────────────────────────────────────────────────────── *@
<div class="d-flex justify-content-between align-items-center mb-3 d-print-none flex-wrap gap-2">
    <a href="/" class="btn btn-outline-secondary btn-sm">← رجوع</a>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <label class="form-label mb-0 fw-semibold small">من:</label>
        <input type="date" class="form-control form-control-sm" style="width:150px;"
               @bind="dateFrom" />
        <label class="form-label mb-0 fw-semibold small">إلى:</label>
        <input type="date" class="form-control form-control-sm" style="width:150px;"
               @bind="dateTo" />
        <button class="btn btn-primary btn-sm" @onclick="Load">
            🔍 عرض
        </button>
        <button class="btn btn-outline-dark btn-sm" @onclick="Print"
                disabled="@exporting">
            @if (exporting)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            🖨 طباعة
        </button>
    </div>
</div>

@* ── Printable content ─────────────────────────────────────────────────────── *@
<div id="stat2-content" dir="ltr"
     style="background:white;padding:20px;font-family:'Arial',sans-serif;font-size:.72rem;">

    @* Header *@
    <div style="text-align:center;margin-bottom:4px;">
        <div style="font-weight:bold;font-size:.9rem;">
            RÉPUBLIQUE ALGÉRIENNE DÉMOCRATIQUE ET POPULAIRE
        </div>
        <div style="font-weight:bold;">MINISTÈRE DES FINANCES</div>
    </div>

    <div style="margin-bottom:6px;font-size:.75rem;">
        <div>DIRECTION GENERALE DES IMPÔTS</div>
        <div>DIRECTION REGIONAL DES IMPÔTS DE.... @org.Diraya</div>
        <div>DIRECTION DES IMPÔTS DE...... @org.Qabada</div>
    </div>

    <div style="text-align:center;font-weight:bold;margin-bottom:4px;font-size:.85rem;">
        SITUATION HEBDOMADAIRE DES MESURES D'ASSAINISSEMENT<br />
        DES CRÉANCES FISCALES PAR SECTEUR D'ACTIVITÉ (2012-2025)
    </div>

    <div style="text-align:center;margin-bottom:4px;font-size:.8rem;">
        SEMAINE DU <u>&nbsp;&nbsp;@dateFrom.ToString("dd/MM/yyyy")&nbsp;&nbsp;</u>
        AU <u>&nbsp;&nbsp;@dateTo.ToString("dd/MM/yyyy")&nbsp;&nbsp;</u>
    </div>

    <div style="text-align:center;margin-bottom:10px;font-size:.78rem;">
        (Article 122 LF2026)
    </div>

    @* Table *@
    <table style="width:100%;border-collapse:collapse;font-size:.65rem;">
        <thead>
            <tr style="background:#ddd;font-weight:bold;text-align:center;vertical-align:middle;">
                <td rowspan="2" style="@th;width:70px;">DRI/DIW</td>
                <td rowspan="2" style="@th;width:75px;">
                    Montant total éligible (70%) des droits simples
                </td>
                <td colspan="4" style="@th;">Entreprises du secteur public</td>
                <td colspan="4" style="@th;">Entreprises du secteur privé et autre</td>
                <td colspan="4" style="@th;">Entreprises étrangères non installées ou établissement stables</td>
                <td rowspan="2" style="@th;width:55px;">RAR</td>
            </tr>
            <tr style="background:#eee;font-weight:bold;text-align:center;vertical-align:middle;">
                <td style="@th;width:50px;">Nombre de souscripteur paiement intégral</td>
                <td style="@th;width:65px;">Montant du Paiement intégral (70% des droits)</td>
                <td style="@th;width:50px;">Nombre de Souscripteur (Paiement fractionné)</td>
                <td style="@th;width:65px;">Montant du paiement fractionné (70% des droits simples)</td>
                <td style="@th;width:50px;">Le nombre de souscripteur (paiement intégral)</td>
                <td style="@th;width:65px;">Montant du Paiement intégral</td>
                <td style="@th;width:50px;">Le nombre de souscripteur (Paiement fractionné)</td>
                <td style="@th;width:65px;">Montant du paiement fractionné (70% des droits simples)</td>
                <td style="@th;width:50px;">Le nombre de souscripteur (paiement intégral)</td>
                <td style="@th;width:65px;">Montant du Paiement intégral (70% des droits)</td>
                <td style="@th;width:50px;">Le nombre de souscripteur (Paiement fractionné)</td>
                <td style="@th;width:65px;">Montant du paiement fractionné</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in rows)
            {
                <tr style="text-align:center;vertical-align:middle;">
                    <td style="@td">@row.Label</td>
                    <td style="@td;font-weight:bold;">@Fmt(row.TotalEligible)</td>
                    <td style="@td">@N(row.PublicNbIntegral)</td>
                    <td style="@td">@Fmt(row.PublicMontantIntegral)</td>
                    <td style="@td">@N(row.PublicNbFractionne)</td>
                    <td style="@td">@Fmt(row.PublicMontantFractionne)</td>
                    <td style="@td">@N(row.PriveNbIntegral)</td>
                    <td style="@td">@Fmt(row.PriveMontantIntegral)</td>
                    <td style="@td">@N(row.PriveNbFractionne)</td>
                    <td style="@td">@Fmt(row.PriveMontantFractionne)</td>
                    <td style="@td">@N(row.EtrangerNbIntegral)</td>
                    <td style="@td">@Fmt(row.EtrangerMontantIntegral)</td>
                    <td style="@td">@N(row.EtrangerNbFractionne)</td>
                    <td style="@td">@Fmt(row.EtrangerMontantFractionne)</td>
                    <td style="@td;color:red;font-weight:bold;">@Fmt(row.RAR)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr style="background:#eee;font-weight:bold;text-align:center;">
                <td style="@td">TOTAL</td>
                <td style="@td">@Fmt(rows.Sum(r => r.TotalEligible))</td>
                <td style="@td">@N(rows.Sum(r => r.PublicNbIntegral))</td>
                <td style="@td">@Fmt(rows.Sum(r => r.PublicMontantIntegral))</td>
                <td style="@td">@N(rows.Sum(r => r.PublicNbFractionne))</td>
                <td style="@td">@Fmt(rows.Sum(r => r.PublicMontantFractionne))</td>
                <td style="@td">@N(rows.Sum(r => r.PriveNbIntegral))</td>
                <td style="@td">@Fmt(rows.Sum(r => r.PriveMontantIntegral))</td>
                <td style="@td">@N(rows.Sum(r => r.PriveNbFractionne))</td>
                <td style="@td">@Fmt(rows.Sum(r => r.PriveMontantFractionne))</td>
                <td style="@td">@N(rows.Sum(r => r.EtrangerNbIntegral))</td>
                <td style="@td">@Fmt(rows.Sum(r => r.EtrangerMontantIntegral))</td>
                <td style="@td">@N(rows.Sum(r => r.EtrangerNbFractionne))</td>
                <td style="@td">@Fmt(rows.Sum(r => r.EtrangerMontantFractionne))</td>
                <td style="@td;color:red;">@Fmt(rows.Sum(r => r.RAR))</td>
            </tr>
        </tfoot>
    </table>

    @* Signature *@
    <div style="text-align:right;margin-top:30px;font-size:.78rem;">
        A ............. LE .......................
    </div>
</div>

@code {

    const string th = "border:1px solid black;padding:4px 3px;vertical-align:middle;";
    const string td = "border:1px solid #999;padding:3px 2px;";

    DateTime dateFrom = DateTime.Today.AddDays(-7);
    DateTime dateTo = DateTime.Today;
    AppSettings org = new();
    bool exporting = false;
    List<Stat2Row> rows = [];

    protected override async Task OnInitializedAsync()
    {
        org = await AppSettingsService.GetAsync();
        await Load();
    }

    async Task Load()
    {
        var declarations = await DeclarationService.GetAllAsync();
        var redevables = await RedevableService.GetAllAsync();

        var filtered = declarations
            .Where(d => d.Date.Date >= dateFrom.Date && d.Date.Date <= dateTo.Date)
            .ToList();

        var row = new Stat2Row { Label = org.Qabada };

        foreach (var decl in filtered)
        {
            var rev = redevables.FirstOrDefault(r => r.Id == decl.RedevableInfoId);
            if (rev == null) continue;

            var montant70 = decl.MontantRestant;
            var abattement = decl.IsValidatedByDG ? decl.Droit * 0.30m : 0m;
            var annulation = decl.IsValidatedByDG ? (decl.AlghaPA + decl.AlghaPR) : 0m;

            var collected = decl.DafaaWahida
                ? (decl.EstPaye ? montant70 : 0m)
                : decl.Versements.Where(v => v.EstPaye).Sum(v => v.Montant);

            var rar = Math.Max(0, decl.MontantTotal - collected - abattement - annulation);

            row.TotalEligible += montant70;
            row.RAR += rar;

            var isIntegral = decl.DafaaWahida;

            // For fractionné columns: sum of PAID versements only
            var fractionneMontant = decl.AlaAqsat
                ? decl.Versements.Where(v => v.EstPaye).Sum(v => v.Montant)
                : 0m;

            switch (rev.Secteur)
            {
                case SecteurActivite.Public:
                    if (isIntegral)
                    {
                        row.PublicNbIntegral++;
                        row.PublicMontantIntegral += montant70;
                    }
                    else
                    {
                        row.PublicNbFractionne++;
                        row.PublicMontantFractionne += fractionneMontant;
                    }
                    break;

                case SecteurActivite.Etranger:
                    if (isIntegral)
                    {
                        row.EtrangerNbIntegral++;
                        row.EtrangerMontantIntegral += montant70;
                    }
                    else
                    {
                        row.EtrangerNbFractionne++;
                        row.EtrangerMontantFractionne += fractionneMontant;
                    }
                    break;

                default: // Prive
                    if (isIntegral)
                    {
                        row.PriveNbIntegral++;
                        row.PriveMontantIntegral += montant70;
                    }
                    else
                    {
                        row.PriveNbFractionne++;
                        row.PriveMontantFractionne += fractionneMontant;
                    }
                    break;
            }
        }

        rows = [row];
    }

    async Task Print()
    {
        exporting = true;
        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                var w = window.open('', '_blank');
                var content = document.getElementById('stat2-content').innerHTML;
                w.document.write('<html><head><title>Stat2</title><style>body{margin:20px;font-family:Arial,sans-serif;}</style></head><body>' + content + '</body></html>');
                w.document.close();
                w.print();
            ");
        }
        finally { exporting = false; }
    }

    static string Fmt(decimal v) =>
        v == 0 ? "" :
        string.Format("{0:N0}", Math.Round(v, 0, MidpointRounding.AwayFromZero))
              .Replace(",", " ");

    static string N(int v) => v == 0 ? "" : v.ToString();

    class Stat2Row
    {
        public string Label { get; set; } = "";
        public decimal TotalEligible { get; set; }
        public int PublicNbIntegral { get; set; }
        public decimal PublicMontantIntegral { get; set; }
        public int PublicNbFractionne { get; set; }
        public decimal PublicMontantFractionne { get; set; }
        public int PriveNbIntegral { get; set; }
        public decimal PriveMontantIntegral { get; set; }
        public int PriveNbFractionne { get; set; }
        public decimal PriveMontantFractionne { get; set; }
        public int EtrangerNbIntegral { get; set; }
        public decimal EtrangerMontantIntegral { get; set; }
        public int EtrangerNbFractionne { get; set; }
        public decimal EtrangerMontantFractionne { get; set; }
        public decimal RAR { get; set; }
    }
}
